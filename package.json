{
  "name": "hood-oracle",
  "version": "0.1.0",
  "description": "Autonomous Robinhood Chain (4663) launch trader: a learning conviction oracle scores every NOXA and Odyssey launch, arm-and-guardrail controls, sequencer-feed execution, and a live dashboard.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "nirholas (https://x.com/nichxbt)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/hood-oracle.git"
  },
  "bin": {
    "hood-oracle-mcp": "dist/src/mcp/stdio.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server && npm run build:sdk",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts && npm run build:docs",
    "build:docs": "tsx scripts/build-docs.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/migrate.ts --status",
    "oracle:backfill": "tsx scripts/backfill.ts",
    "oracle:fit": "tsx scripts/fit.ts",
    "check:rules": "node scripts/check-rules.mjs",
    "build:sdk": "npm run build --workspace @hood-oracle/sdk",
    "sync:sdk-contract": "node scripts/sync-sdk-contract.mjs",
    "mcp": "tsx src/mcp/stdio.ts",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "hood402": "^0.1.1",
    "hoodchain": "^0.1.1",
    "marked": "^18.0.11",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "viem": "^2.56.3",
    "ws": "^8.21.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
