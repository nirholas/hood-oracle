# ── database ──────────────────────────────────────────────────────────────────
# Postgres. Local: `docker compose up -d db` gives you this exact URL.
DATABASE_URL=postgres://hood:hood@localhost:5432/hood_oracle

# ── chain ─────────────────────────────────────────────────────────────────────
# mainnet (4663) or testnet (46630)
HOOD_NETWORK=mainnet
# Comma-separated extra RPC URLs, tried in order before the public endpoint.
# An Alchemy accelerator URL here is the single biggest fill-latency win.
RPC_URLS=
# Sequencer firehose (raw txs ~100-300ms before they are queryable). Leave default.
FEED_URL=wss://feed.mainnet.chain.robinhood.com

# ── wallet ────────────────────────────────────────────────────────────────────
# The fleet signing key. Only read when an arm is in live mode. Fund with ETH.
TRADER_PRIVATE_KEY=
# Hard wallet floor: the engine never spends below this many ETH (gas reserve).
MIN_WALLET_ETH=0.005

# ── operator ──────────────────────────────────────────────────────────────────
# Bearer token for every write route (arm/disarm/kill/close). Generate with
# `openssl rand -hex 32`. Read routes and the dashboard are public.
OPERATOR_TOKEN=
PORT=8080
LOG_LEVEL=info

# ── intelligence ──────────────────────────────────────────────────────────────
# Narrative classification and the LLM decision arm. One provider is enough.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# ── alerts ────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── hardening ─────────────────────────────────────────────────────────────────
# Set to 1 behind Cloud Run or any load balancer: the client address for rate
# limiting and the scheme for x402 resource URLs come from X-Forwarded-* then.
TRUST_PROXY=0
# Comma-separated origins allowed to call the API cross-origin. Empty means
# same-origin only. A `*` entry opens reads to any origin but never writes.
CORS_ORIGINS=

# ── x402 pay-per-score ────────────────────────────────────────────────────────
# The address that receives USDG for GET /api/x402/score/:token. Unset keeps
# the paid route disabled (503); the free feed is unaffected.
X402_PAY_TO=
# Price of one verdict in USDG (6 decimals max).
X402_SCORE_PRICE_USDG=0.05
# hood402 facilitator that verifies and settles USDG payments on chain 4663.
X402_FACILITATOR_URL=https://facilitator.hood402.dev
